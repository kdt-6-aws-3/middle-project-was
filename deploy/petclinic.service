[Unit]
Description=PetClinic WAS (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
User=petclinic
Group=petclinic
Environment=TZ=Asia/Seoul
ExecStart=/opt/petclinic/start.sh
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
