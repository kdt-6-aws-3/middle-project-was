# Copied to /etc/petclinic/petclinic.env (root only, chmod 600) by setup-was.sh.
# Replace every <...> value with the information from the DB owner.
SPRING_PROFILES_ACTIVE=mysql
SPRING_DATASOURCE_URL=jdbc:mysql://<RDS endpoint>:3306/petclinic
SPRING_DATASOURCE_USERNAME=<app user>
SPRING_DATASOURCE_PASSWORD=<password>

# Uncomment when the DB owner creates the tables (the app user then needs no CREATE privilege)
# SPRING_SQL_INIT_MODE=never
